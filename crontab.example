# Exemplo de crontab (fuso America/Sao_Paulo). Ajuste KIT para o caminho do clone.
# Os scouts são HTTP puro (sem wallet). O trader NÃO roda por cron direto — é acionado pelo agente.
KIT=$HOME/crypto-agents-kit
# DeFi pools + lending
30 9,11,13,15,17,18 * * 1-5 /bin/bash $KIT/scouts/defi/run-scout.sh >>/tmp/cak-defi.log 2>&1
35 9,13,17 * * 1-5 python3 $KIT/scouts/defi/defillama_lending_scout.py >>/tmp/cak-lending.log 2>&1
# Memes (DexScreener)
0,30 9-17 * * 1-5 /bin/bash $KIT/scouts/meme/run-meme-scout.sh >>/tmp/cak-meme.log 2>&1
0 18 * * 1-5 /bin/bash $KIT/scouts/meme/run-meme-scout.sh >>/tmp/cak-meme.log 2>&1
# Polymarket (Gamma API)
0 10,12,14,16,18 * * 1-5 /bin/bash $KIT/scouts/polymarket/run-polymarket-scout.sh >>/tmp/cak-poly.log 2>&1
# On-chain BTC snapshot
30 8,18 * * 1-5 /bin/bash $KIT/scouts/onchain-btc/run-onchain.sh >>/tmp/cak-onchain.log 2>&1
# pump.fun PAPER (simulação) a cada 15 min + resumo diário
*/15 * * * * /bin/bash $KIT/scouts/pumpfun-paper/run-pumpfun.sh
55 23 * * * python3 $KIT/scouts/pumpfun-paper/pumpfun_daily.py >>/tmp/cak-pumpfun-daily.log 2>&1
