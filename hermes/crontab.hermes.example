# Crontab dos scouts como roda numa instância com Hermes Agent (macOS/Linux, fuso America/Sao_Paulo).
# Só as linhas cripto; ajuste KIT para o caminho do clone. Saídas em scouts/<nome>/out/.
KIT=$HOME/crypto-agents-kit
PY=python3
# DeFi Scout (script compartilhado com o job Hermes "DeFi Scout"; aqui com --no-alert)
0,45 9-17 * * * /bin/bash $KIT/scouts/defi/run-scout.sh >>/tmp/cak-defi.log 2>&1
0 18 * * *      /bin/bash $KIT/scouts/defi/run-scout.sh >>/tmp/cak-defi.log 2>&1
# Polymarket (Gamma API) — o enrich do Hermes roda às :01/:46
0,45 9-17 * * * /bin/bash $KIT/scouts/polymarket/run-polymarket-scout.sh >>/tmp/cak-poly.log 2>&1
0 18 * * *      /bin/bash $KIT/scouts/polymarket/run-polymarket-scout.sh >>/tmp/cak-poly.log 2>&1
# Meme Scout (DexScreener; salva raw por execução em out/history/)
0,30 9-17 * * * /bin/bash $KIT/scouts/meme/run-meme-scout.sh >>/tmp/cak-meme.log 2>&1
0 18 * * *      /bin/bash $KIT/scouts/meme/run-meme-scout.sh >>/tmp/cak-meme.log 2>&1
# On-chain BTC (dias úteis) — o relatório completo é o job Hermes "On-Chain BTC Report" às :32
30 8,18 * * 1-5 /bin/bash $KIT/scouts/onchain-btc/run-onchain.sh >>/tmp/cak-onchain.log 2>&1
# Auditoria de rotinas (segunda) — enrich do Hermes às 09:01
0 9 * * 1       /bin/bash $KIT/scouts/auditoria-rotinas/run-auditoria.sh >>/tmp/cak-auditoria.log 2>&1
# pump.fun PAPER: varredura 9–22h a cada 15 min + 23:00; posições a cada 5 min 24h; resumo 23:05
*/15 9-22 * * * /bin/bash $KIT/scouts/pumpfun-paper/run-pumpfun.sh
0 23 * * *      /bin/bash $KIT/scouts/pumpfun-paper/run-pumpfun.sh
*/5 * * * *     /bin/bash $KIT/scouts/pumpfun-paper/run-pumpfun.sh --positions-only
5 23 * * *      $PY $KIT/scouts/pumpfun-paper/pumpfun_daily.py >>/tmp/cak-pumpfun-daily.log 2>&1
# relatório final no dia definido em PUMPFUN_FINAL_DAY (o --auto ignora outros dias)
10 23 * * *     $PY $KIT/scouts/pumpfun-paper/pumpfun_daily.py --final --auto >>/tmp/cak-pumpfun-daily.log 2>&1
# Espelho no Obsidian (opcional)
3,18,33,48 8-23 * * * VAULT_SYNC_LAYOUT=kit $PY $KIT/hermes/vault-sync/sync_vault.py >>/tmp/cak-vault-sync.log 2>&1
