# Copie para .env (gitignored) e preencha. NUNCA commite valores reais.
# Carregue com:  set -a; . ./.env; set +a

# ---------- Trader (EVM / Uniswap v3 / Aave) ----------
DEFI_WALLET_ADDRESS=0xYOUR_DEDICATED_HOT_WALLET_ADDRESS
# Chave privada da hot wallet dedicada. Prefira um secret manager / env do runtime em vez deste arquivo.
DEFI_WALLET_PRIVATE_KEY=
# Opcional: JSON local com {"DEFI_WALLET_PRIVATE_KEY": "...", "SOLANA_PRIVATE_KEY": "..."} (fora do git)
SECRETS_FILE=
# Estado local (wallet.address, journal, status). Default: trader/state/ (gitignored)
DEFI_STATE_DIR=
DEFAULT_CHAIN=arbitrum

# ---------- Caps de risco ----------
BANKROLL_USD=50
MAX_POSITION_PCT=50
# Teto absoluto por posição (o menor entre PCT*bankroll e este valor vale)
MAX_POSITION_USD=25
SLIPPAGE_BPS=100
# 1 = só simula. Live exige DRY_RUN=0 E a flag --execute
DRY_RUN=1
# manual (humano aprova cada trade) | auto (somente ≤ MAX_POSITION_USD e checks ok)
TRADER_MODE=manual

# ---------- RPCs (públicos por default; se usar provedor com API key, NÃO commite) ----------
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_BASE=https://mainnet.base.org
RPC_ETHEREUM=https://ethereum.publicnode.com
RPC_OPTIMISM=https://mainnet.optimism.io
RPC_SOLANA=https://api.mainnet-beta.solana.com

# ---------- LP report ----------
# ids das posições NFT Uni v3 separados por vírgula (vazio = enumera on-chain)
LP_TOKEN_IDS=
LP_POOL_ADDRESS=0xC6962004f452bE9203591991D15f6b388e09E8D0
DEFILLAMA_POOL_ID=a14bd201-764c-40a5-86b8-2928b2461232

# ---------- Solana / Jupiter ----------
SOLANA_WALLET_ADDRESS=YOUR_SOLANA_PUBKEY
SOLANA_PRIVATE_KEY=
# Opcional (tier pago Jupiter)
JUPITER_API_KEY=
# JUPITER_BASE=https://lite-api.jup.ag/swap/v1

# ---------- Scouts ----------
# Saída de cada scout: scouts/<nome>/out (override por execução com SCOUT_OUT_DIR=... — não use um único dir p/ todos)
LENDING_CHAINS=Arbitrum,Base,Optimism,Ethereum
LENDING_MIN_TVL_USD=10000000
# pump.fun paper: ISO datetime para parar novas entradas (vazio = sem corte)
PUMPFUN_CUTOFF_NEW=
# Dia (YYYY-MM-DD) em que `pumpfun_daily.py --final --auto` gera o relatório final
PUMPFUN_FINAL_DAY=
# Comando opcional de LLM CLI para enriquecer o relatório on-chain (ex.: "hermes -z")
LLM_CLI=

# ---------- Research ----------
BRIDGE_SOL_USER=

# ---------- Dashboard ----------
# Relay opcional p/ contornar rate-limit (ex.: "ssh -o BatchMode=yes user@relay-host"); vazio = desligado
RELAY_SSH=
PORT=8765
